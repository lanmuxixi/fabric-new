STACK_NAME=fabricdns
SWARM_NETWORK=fabric_dns

# Image used by every peer service. The helper script tags the local build to
# fabric-dns-peer:swarm by default.
FABRIC_PEER_IMAGE=fabric-dns-peer:swarm

CORE_PEER_NETWORKID=dev
CORE_LOGGING_LEVEL=info

# This subnet is consumed by core/peer/peer.go when CORE_PEER_ADDRESSAUTODETECT
# is enabled. Set it to the management/data subnet that your Swarm nodes use.
CORE_DNS_SUBNET=10.92.2.0/24

# Pin each validating peer to a specific Swarm node hostname.
VP0_NODE=dns-fabric-01
VP1_NODE=dns-fabric-02
VP2_NODE=dns-fabric-03
VP3_NODE=dns-bind-01

# Published ports for vp0, which doubles as the CLI entrypoint peer.
VP0_REST_PORT=7050
VP0_GRPC_PORT=7051
VP0_EVENTS_PORT=7053
VP0_PROFILE_PORT=6060

# Chaincode deployment helper uses the published vp0 gRPC endpoint.
VP0_ENDPOINT=10.92.2.138:7051

# Example ctor for the current bind9-support chaincode. This branch uses the
# simple init/add/delete/resolveDomain API, not TopLevelUpdate.
CHAINCODE_CTOR={"Function":"init","Args":["com:10.92.2.140","cn:10.92.2.140"]}
