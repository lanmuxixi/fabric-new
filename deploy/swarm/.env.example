STACK_NAME=fabricdns
SWARM_NETWORK=fabric_dns

# Image used by every peer service. The helper script tags the local build to
# fabric-dns-peer:swarm by default.
FABRIC_PEER_IMAGE=fabric-dns-peer:swarm
BIND_IMAGE=internetsystemsconsortium/bind9:9.18

CORE_PEER_NETWORKID=dev
CORE_LOGGING_LEVEL=info
PEER_START_DELAY=10
CORE_PBFT_GENERAL_N=30
CORE_PBFT_GENERAL_F=9

# This subnet is consumed by core/peer/peer.go when CORE_PEER_ADDRESSAUTODETECT
# is enabled. Set it to the management/data subnet that your Swarm nodes use.
CORE_DNS_SUBNET=10.161.34.0/24

# Pin each validating peer to the intended 30-node layout across the 2 lab servers.
VP0_NODE=roott-I620-G20
VP1_NODE=roott-I620-G20
VP2_NODE=roott-I620-G20
VP3_NODE=roott-I620-G20
VP4_NODE=roott-I620-G20
VP5_NODE=roott-I620-G20
VP6_NODE=roott-I620-G20
VP7_NODE=roott-I620-G20
VP8_NODE=roott-I620-G20
VP9_NODE=roott-I620-G20
VP10_NODE=roott-I620-G20
VP11_NODE=roott-I620-G20
VP12_NODE=roott-I620-G20
VP13_NODE=roott-I620-G20
VP14_NODE=roott-I620-G20
VP15_NODE=qichang-I420-G20
VP16_NODE=qichang-I420-G20
VP17_NODE=qichang-I420-G20
VP18_NODE=qichang-I420-G20
VP19_NODE=qichang-I420-G20
VP20_NODE=qichang-I420-G20
VP21_NODE=qichang-I420-G20
VP22_NODE=qichang-I420-G20
VP23_NODE=qichang-I420-G20
VP24_NODE=qichang-I420-G20
VP25_NODE=qichang-I420-G20
VP26_NODE=qichang-I420-G20
VP27_NODE=qichang-I420-G20
VP28_NODE=qichang-I420-G20
VP29_NODE=qichang-I420-G20
BIND_NODE=qichang-I420-G20

# Experiment 1 is the honest baseline; all byzantine flags remain false.
VP0_BYZANTINE=false
VP1_BYZANTINE=false
VP2_BYZANTINE=false
VP3_BYZANTINE=false
VP4_BYZANTINE=false
VP5_BYZANTINE=false
VP6_BYZANTINE=false
VP7_BYZANTINE=false
VP8_BYZANTINE=false
VP9_BYZANTINE=false
VP10_BYZANTINE=false
VP11_BYZANTINE=false
VP12_BYZANTINE=false
VP13_BYZANTINE=false
VP14_BYZANTINE=false
VP15_BYZANTINE=false
VP16_BYZANTINE=false
VP17_BYZANTINE=false
VP18_BYZANTINE=false
VP19_BYZANTINE=false
VP20_BYZANTINE=false
VP21_BYZANTINE=false
VP22_BYZANTINE=false
VP23_BYZANTINE=false
VP24_BYZANTINE=false
VP25_BYZANTINE=false
VP26_BYZANTINE=false
VP27_BYZANTINE=false
VP28_BYZANTINE=false
VP29_BYZANTINE=false

# Published ports for vp0, which doubles as the CLI entrypoint peer.
VP0_REST_PORT=7050
VP0_GRPC_PORT=7051
VP0_EVENTS_PORT=7053
VP0_PROFILE_PORT=6060

# Chaincode deployment helper uses the published vp0 gRPC endpoint.
VP0_ENDPOINT=10.161.34.8:7051

# Bind9 host paths on the Bind9 target node. These directories must exist there.
BIND_CONFIG_DIR=/opt/fabric-dns/bind/config
BIND_CACHE_DIR=/opt/fabric-dns/bind/cache
BIND_RECORDS_DIR=/opt/fabric-dns/bind/records
BIND_TCP_PORT=53
BIND_UDP_PORT=53

# Default DNS chaincode bootstrap. The new chaincode exposes TopLevel* APIs and
# TopLevelGetAll for verification, but still uses init for the first TLD seeds.
CHAINCODE_CTOR={"Function":"init","Args":["com:10.161.34.51:53","cn:10.161.34.51:53"]}
