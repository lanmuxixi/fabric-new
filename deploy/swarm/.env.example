STACK_NAME=fabricdns
SWARM_NETWORK=fabric_dns

# Image used by every peer service. The helper script tags the local build to
# fabric-dns-peer:swarm by default.
FABRIC_PEER_IMAGE=fabric-dns-peer:swarm
BIND_IMAGE=internetsystemsconsortium/bind9:9.18

CORE_PEER_NETWORKID=dev
CORE_LOGGING_LEVEL=info
PEER_START_DELAY=10
CORE_PBFT_GENERAL_N=10
CORE_PBFT_GENERAL_F=3
CORE_PBFT_GENERAL_BATCHSIZE=500
CORE_PBFT_GENERAL_TIMEOUT_BATCH=1s
# Keep view change effectively disabled during long experiments.
CORE_PBFT_GENERAL_TIMEOUT_REQUEST=876000h
CORE_PBFT_GENERAL_TIMEOUT_VIEWCHANGE=876000h
CORE_PBFT_GENERAL_TIMEOUT_RESENDVIEWCHANGE=876000h
CORE_PBFT_GENERAL_TIMEOUT_BROADCAST=2s
CORE_PBFT_GENERAL_VIEWCHANGEPERIOD=0

# This subnet is consumed by core/peer/peer.go if address auto-detection is
# enabled. Swarm uses CORE_PEER_ADDRESSAUTODETECT=false, but keep this aligned
# with the host subnet for compatibility with the original branch.
CORE_DNS_SUBNET=10.161.34.0/24
DNS_CHAINCODEID=
DNS_DELAYENABLE=false

# Pin each validating peer to the intended 10-node layout across two hosts.
VP0_NODE=dns-fabric-01
VP1_NODE=dns-fabric-01
VP2_NODE=dns-fabric-01
VP3_NODE=dns-fabric-01
VP4_NODE=dns-fabric-01
VP5_NODE=dns-fabric-02
VP6_NODE=dns-fabric-02
VP7_NODE=dns-fabric-02
VP8_NODE=dns-fabric-02
VP9_NODE=dns-fabric-02
BIND_NODE=dns-fabric-02

# Marker nodes for the one-third-malicious experiment variant.
VP0_BYZANTINE=false
VP4_BYZANTINE=false
VP8_BYZANTINE=false
VP1_BYZANTINE=false
VP2_BYZANTINE=false
VP3_BYZANTINE=false
VP5_BYZANTINE=false
VP6_BYZANTINE=false
VP7_BYZANTINE=false
VP9_BYZANTINE=false

# Published ports for vp0, which doubles as the CLI entrypoint peer.
VP0_REST_PORT=7050
VP0_GRPC_PORT=7051
VP0_EVENTS_PORT=7053
VP0_PROFILE_PORT=6060

# Chaincode deployment helper uses the published vp0 gRPC endpoint.
VP0_ENDPOINT=10.161.34.8:7051

# Bind9 host paths on BIND_NODE. These directories must exist on that VM.
BIND_CONFIG_DIR=/opt/fabric-dns/bind/config
BIND_CACHE_DIR=/opt/fabric-dns/bind/cache
BIND_RECORDS_DIR=/opt/fabric-dns/bind/records
BIND_TCP_PORT=53
BIND_UDP_PORT=53

# Default DNS chaincode bootstrap for the original table-based DNS chaincode.
CHAINCODE_CTOR={"Function":"init","Args":["com:10.161.34.51:53","cn:10.161.34.51:53"]}
