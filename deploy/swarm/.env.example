STACK_NAME=fabricdns
SWARM_NETWORK=fabric_dns

# Image used by every peer service. The helper script tags the local build to
# fabric-dns-peer:swarm by default.
FABRIC_PEER_IMAGE=fabric-dns-peer:swarm
BIND_IMAGE=internetsystemsconsortium/bind9:9.18

CORE_PEER_NETWORKID=dev
CORE_LOGGING_LEVEL=info
PEER_START_DELAY=10
CORE_PBFT_GENERAL_N=10
CORE_PBFT_GENERAL_F=3

# This subnet is consumed by core/peer/peer.go when CORE_PEER_ADDRESSAUTODETECT
# is enabled. Set it to the management/data subnet that your Swarm nodes use.
CORE_DNS_SUBNET=10.92.2.0/24

# Pin each validating peer to the intended 10-node layout across the 4 VMs.
VP0_NODE=dns-fabric-01
VP1_NODE=dns-fabric-01
VP2_NODE=dns-fabric-01
VP3_NODE=dns-fabric-02
VP4_NODE=dns-fabric-02
VP5_NODE=dns-fabric-02
VP6_NODE=dns-fabric-03
VP7_NODE=dns-fabric-03
VP8_NODE=dns-bind-01
VP9_NODE=dns-bind-01
BIND_NODE=dns-bind-01

# Marker nodes for the one-third-malicious experiment variant.
VP0_BYZANTINE=false
VP4_BYZANTINE=false
VP8_BYZANTINE=false
VP1_BYZANTINE=false
VP2_BYZANTINE=false
VP3_BYZANTINE=false
VP5_BYZANTINE=false
VP6_BYZANTINE=false
VP7_BYZANTINE=false
VP9_BYZANTINE=false

# When a byzantine primary rewrites TopLevelUpdate, it will point the hijacked
# TLD to this authority server.
DNS_BZAUTHORITY=10.92.2.141:53

# Published ports for vp0, which doubles as the CLI entrypoint peer.
VP0_REST_PORT=7050
VP0_GRPC_PORT=7051
VP0_EVENTS_PORT=7053
VP0_PROFILE_PORT=6060

# Chaincode deployment helper uses the published vp0 gRPC endpoint.
VP0_ENDPOINT=10.92.2.138:7051

# Bind9 host paths on dns-bind-01. These directories must exist on that VM.
BIND_CONFIG_DIR=/opt/fabric-dns/bind/config
BIND_CACHE_DIR=/opt/fabric-dns/bind/cache
BIND_RECORDS_DIR=/opt/fabric-dns/bind/records
BIND_TCP_PORT=53
BIND_UDP_PORT=53

# Default DNS chaincode bootstrap. The new chaincode exposes TopLevel* APIs and
# TopLevelGetAll for verification, but still uses init for the first TLD seeds.
CHAINCODE_CTOR={"Function":"init","Args":["com:10.92.2.140:53","cn:10.92.2.140:53"]}
